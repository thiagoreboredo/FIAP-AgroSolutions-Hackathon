  "item": [
    {
      "name": "1. Identity - Registrar Usuário",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();\r",
              "\r",
              "if (jsonData.token) {\r",
              "    // Pega a segunda parte do JWT (o payload)\r",
              "    var payloadBase64 = jsonData.token.split('.')[1];\r",
              "    \r",
              "    // Ajusta o formato Base64Url para Base64 normal\r",
              "    var padding = '='.repeat((4 - payloadBase64.length % 4) % 4);\r",
              "    var base64 = (payloadBase64 + padding).replace(/\\-/g, '+').replace(/_/g, '/');\r",
              "    \r",
              "    // Decodifica e converte para JSON\r",
              "    var decodedPayload = JSON.parse(atob(base64));\r",
              "    \r",
              "    // Salva o Token e o ID do usuário nas variáveis da coleção\r",
              "    pm.collectionVariables.set(\"owner_id\", decodedPayload.sub);\r",
              "    pm.collectionVariables.set(\"jwt_token\", jsonData.token);\r",
              "    \r",
              "    console.log(\"Variáveis atualizadas! OwnerID: \" + decodedPayload.sub);\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"name\": \"Thiago\",\r\n  \"email\": \"thiago2@agrosolutions.com\",\r\n  \"password\": \"SenhaForte123!\"\r\n}"
        },
        "url": {
          "raw": "http://localhost/api/auth/register",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
